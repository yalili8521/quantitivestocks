// QQQ 1min Pure Runner — 1-minute timeframe
// Morning entry (9:30-11:00 ET), single trailing stop exits 100%
// After BE trigger, stop moves above entry and trail activates
// Market close backstop at 16:00 ET
// Timeframe: 1-min on QQQ

//@version=6
strategy("QQQ 1min Pure Runner",
     overlay        = true,
     initial_capital = 5000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 95,
     commission_type = strategy.commission.percent,
     commission_value = 0,
     slippage       = 1,
     pyramiding     = 0,
     calc_on_every_tick = false)

// ─── Inputs ───
ma_fast_len   = input.int(5,   "Fast MA (5)",   minval=2)
ma_mid_len    = input.int(10,  "Mid MA (10)",   minval=3)
ma_slow_len   = input.int(20,  "Slow MA (20)",  minval=5)

// Accumulation
acc_lookback  = input.int(10,  "Accumulation lookback bars", minval=3)
acc_min_bars  = input.int(6,   "Min bars rising (of lookback)", minval=2)
max_bar_size  = input.float(0.10, "Max single bar % (reject spikes)", minval=0.01, step=0.01)

// Session — entries only during this window (ET)
use_session       = input.bool(true, "Use session filter")
session_start_h   = input.int(4,   "Session start hour (ET)", minval=0, maxval=23)
session_start_m   = input.int(0,   "Session start minute", minval=0, maxval=59)
session_end_h     = input.int(20,  "Session end hour (ET)", minval=0, maxval=23)
session_end_m     = input.int(0,   "Session end minute", minval=0, maxval=59)

// ─── Stop Loss & Trailing ───
be_trigger_pct = input.float(0.10, "BE trigger % (activates trail)", minval=0.01, step=0.01)
sl_pct         = input.float(0.20, "Initial Stop Loss %", minval=0.01, step=0.01)
trail_pct      = input.float(0.15, "Trailing Stop %", minval=0.01, step=0.01)

// Other
allow_short   = input.bool(true, "Allow shorts")
cooldown_bars = input.int(15, "Bars between trades (1-min bars)", minval=0)

// ─── Session Time Check ───
et_hour   = hour(time, "America/New_York")
et_minute = minute(time, "America/New_York")
et_time   = et_hour * 100 + et_minute

sess_start_time = session_start_h * 100 + session_start_m
sess_end_time   = session_end_h * 100 + session_end_m

in_session = use_session ? (et_time >= sess_start_time and et_time < sess_end_time) : true

// Force close at extended hours end (20:00 ET)
force_close = use_session and et_time >= 1955 and et_time < 2000

// ─── Calculations ───
ma_fast = ta.sma(close, ma_fast_len)
ma_mid  = ta.sma(close, ma_mid_len)
ma_slow = ta.sma(close, ma_slow_len)

// ─── MA Stack ───
bull_stack = ma_fast > ma_mid and ma_mid > ma_slow
bear_stack = ma_fast < ma_mid and ma_mid < ma_slow
price_above = close > ma_fast
price_below = close < ma_fast

// ─── Accumulation: Steady Grind ───
bars_rising = 0
for i = 0 to acc_lookback - 1
    if close[i] > close[i + 1]
        bars_rising += 1

bars_falling = 0
for i = 0 to acc_lookback - 1
    if close[i] < close[i + 1]
        bars_falling += 1

no_spike = true
for i = 0 to acc_lookback - 1
    bar_move = math.abs(close[i] - open[i]) / open[i] * 100
    if bar_move > max_bar_size
        no_spike := false

accumulating = bars_rising >= acc_min_bars and no_spike
distributing = bars_falling >= acc_min_bars and no_spike

mas_rising  = ma_fast > ma_fast[1] and ma_mid > ma_mid[1]
mas_falling = ma_fast < ma_fast[1] and ma_mid < ma_mid[1]

// ─── Cooldown ───
var int bars_since_exit = 999
if strategy.position_size == 0
    bars_since_exit += 1
else
    bars_since_exit := 0

cooled_off = bars_since_exit >= cooldown_bars

// ─── Entry Signals ───
long_entry  = bull_stack and price_above and accumulating and mas_rising and in_session and cooled_off
short_entry = allow_short and bear_stack and price_below and distributing and mas_falling and in_session and cooled_off

long_trigger  = long_entry and not long_entry[1]
short_trigger = short_entry and not short_entry[1]

// ─── State ───
var float entry_price  = na
var int   entry_bar    = 0
var float stop_level   = na
var float peak_price   = na
var bool  is_trailing  = false

// ─── Long Entry ───
if long_trigger and strategy.position_size <= 0
    entry_price  := close
    entry_bar    := bar_index
    stop_level   := close * (1 - sl_pct / 100)
    peak_price   := close
    is_trailing  := false
    strategy.entry("Long", strategy.long)

// ─── Short Entry ───
if short_trigger and strategy.position_size >= 0
    entry_price  := close
    entry_bar    := bar_index
    stop_level   := close * (1 + sl_pct / 100)
    peak_price   := close
    is_trailing  := false
    strategy.entry("Short", strategy.short)

// ─── Track Peak Price ───
if strategy.position_size > 0
    if high > peak_price
        peak_price := high
if strategy.position_size < 0
    if low < peak_price
        peak_price := low

// ─── BE Trigger: activate trailing stop ───
if strategy.position_size > 0 and not is_trailing
    if high >= entry_price * (1 + be_trigger_pct / 100)
        is_trailing := true
        floor_level = entry_price * (1 + 0.02 / 100)  // BE + tiny buffer
        new_stop = peak_price * (1 - trail_pct / 100)
        stop_level := math.max(floor_level, new_stop)

if strategy.position_size < 0 and not is_trailing
    if low <= entry_price * (1 - be_trigger_pct / 100)
        is_trailing := true
        floor_level = entry_price * (1 - 0.02 / 100)
        new_stop = peak_price * (1 + trail_pct / 100)
        stop_level := math.min(floor_level, new_stop)

// ─── Update trailing stop ───
if is_trailing and strategy.position_size > 0
    new_stop = peak_price * (1 - trail_pct / 100)
    if new_stop > stop_level
        stop_level := new_stop

if is_trailing and strategy.position_size < 0
    new_stop = peak_price * (1 + trail_pct / 100)
    if new_stop < stop_level
        stop_level := new_stop

// ─── Stop Loss / Trail Stop exit ───
if strategy.position_size > 0 and close <= stop_level
    exit_comment = is_trailing ? "Trail Stop" : "Stop Loss"
    strategy.close("Long", comment=exit_comment)

if strategy.position_size < 0 and close >= stop_level
    exit_comment = is_trailing ? "Trail Stop" : "Stop Loss"
    strategy.close("Short", comment=exit_comment)

// ─── Market Close Exit ───
if force_close and strategy.position_size > 0
    strategy.close("Long", comment="Market Close")
if force_close and strategy.position_size < 0
    strategy.close("Short", comment="Market Close")

// ─── Reset on flat ───
if strategy.position_size == 0
    is_trailing := false

// ─── Plots ───
plot(ma_fast, "MA5",  color=color.new(color.lime, 0),   linewidth=2)
plot(ma_mid,  "MA10", color=color.new(color.blue, 0),   linewidth=2)
plot(ma_slow, "MA20", color=color.new(color.orange, 0), linewidth=2)

stop_color = is_trailing ? color.new(color.blue, 0) : color.new(color.red, 0)
plot(strategy.position_size != 0 ? stop_level : na, "Stop", color=stop_color, style=plot.style_linebr, linewidth=2)

plot(strategy.position_size > 0 ? peak_price : na, "Peak", color=color.new(color.yellow, 50), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 ? peak_price : na, "Trough", color=color.new(color.yellow, 50), style=plot.style_linebr, linewidth=1)

plot(strategy.position_size > 0 and not is_trailing ? entry_price * (1 + be_trigger_pct/100) : na, "BE Trigger", color=color.new(color.green, 40), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 and not is_trailing ? entry_price * (1 - be_trigger_pct/100) : na, "BE Trigger", color=color.new(color.red, 40), style=plot.style_linebr, linewidth=1)

sess_bg = in_session ? color.new(color.blue, 96) : na
bgcolor(sess_bg)
bg = bull_stack and accumulating and in_session ? color.new(color.green, 88) :
     bear_stack and distributing and in_session ? color.new(color.red, 88) : na
bgcolor(bg)

plotshape(long_trigger  and strategy.position_size[1] <= 0, "Long",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(short_trigger and strategy.position_size[1] >= 0, "Short", shape.triangledown, location.abovebar, color.red,   size=size.small)

// ─── Info Table ───
bars_held = strategy.position_size != 0 ? bar_index - entry_bar : 0

var table info = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(info, 0, 0, "MA Stack", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, bull_stack ? "BULL" : bear_stack ? "BEAR" : "NONE",
         text_color=bull_stack ? color.green : bear_stack ? color.red : color.gray, text_size=size.small)

    table.cell(info, 0, 1, "Grind", text_color=color.white, text_size=size.small)
    string acc_text = accumulating ? "BUYING " : distributing ? "SELLING " : ""
    acc_text += str.tostring(bars_rising) + "up/" + str.tostring(bars_falling) + "dn"
    table.cell(info, 1, 1, acc_text,
         text_color=accumulating ? color.green : distributing ? color.red : color.gray, text_size=size.small)

    table.cell(info, 0, 2, "Session", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, in_session ? "OPEN" : "CLOSED",
         text_color=in_session ? color.green : color.red, text_size=size.small)

    table.cell(info, 0, 3, "Position", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray, text_size=size.small)

    table.cell(info, 0, 4, "Stop", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, strategy.position_size != 0 ? "$" + str.tostring(stop_level, "#.##") : "---",
         text_color=is_trailing ? color.blue : color.yellow, text_size=size.small)

    table.cell(info, 0, 5, "Mode", text_color=color.white, text_size=size.small)
    string mode_text = strategy.position_size == 0 ? "---" : not is_trailing ? "FIXED SL" : "TRAILING"
    table.cell(info, 1, 5, mode_text, text_color=is_trailing ? color.blue : color.yellow, text_size=size.small)

    table.cell(info, 0, 6, "Bars Held", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6, strategy.position_size != 0 ? str.tostring(bars_held) : "---",
         text_color=color.white, text_size=size.small)
