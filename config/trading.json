        "_comment": "Scale effective confidence (and thus size) by OOS Sharpe tier",
        "sharpe_tiers": [
            {"min_sharpe": 1.5,  "multiplier": 1.0,  "label": "core"},
            {"min_sharpe": 0.7,  "multiplier": 0.75, "label": "secondary"},
            {"min_sharpe": 0.3,  "multiplier": 0.50, "label": "on_watch"},
            {"min_sharpe": 0.0,  "multiplier": 0.25, "label": "probe"},
            {"min_sharpe": -999, "multiplier": 0.00, "label": "disabled"}
